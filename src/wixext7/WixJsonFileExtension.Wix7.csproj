<!--
  WiX Toolset v7 flavour of the extension. It compiles the same sources as
  ..\wixext\WixJsonFileExtension.csproj (the v6 flavour) against WixToolset.Extensibility 7.x and
  produces an identically named assembly; the v6 project packs the output of this project into the
  package's wixext7/ folder. The wixlib is version independent (the intermediate format is still
  4.0.0.0 in WiX 7), so both flavours embed the same one.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\wixext\WixJsonFileExtension.Common.props" />

  <PropertyGroup>
    <!-- WiX v7 packages refuse to build unless the Open Source Maintenance Fee EULA is accepted
         (error WIX7015). See https://wixtoolset.org/osmf/ and OSMFEULA.txt in the
         WixToolset.Extensibility package. -->
    <AcceptEula>wix7</AcceptEula>

    <!-- Only the v6 project produces the NuGet package; this one just contributes its assembly. -->
    <IsPackable>false</IsPackable>

    <!-- The sources live next to the v6 project, so the default globs would also pick up that
         project's bin/obj output. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\wixext\**\*.cs" Exclude="..\wixext\bin\**;..\wixext\obj\**;..\wixext\Properties\**" />

    <InternalsVisibleTo Include="WixJsonFileExtension.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\wixlib\bin\x64\$(Configuration)\Hegsie.Wix.JsonExtension.Data.json.wixlib">
      <LogicalName>Hegsie.Wix.JsonExtension.Data.json.wixlib</LogicalName>
      <Link>Hegsie.Wix.JsonExtension.Data.json.wixlib</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Extensibility" Version="7.0.0" />
  </ItemGroup>
</Project>
