<!--
  Settings shared by every flavour of the extension assembly. One assembly is built per supported
  WiX Toolset major version, because WixToolset.Data/WixToolset.Extensibility bump their assembly
  version with each major release (6.0.0.0, 7.0.0.0, ...) and an extension can only bind to the
  version it was compiled against. The flavours are otherwise identical: same sources, same
  assembly name, same version, and each is packed into the matching wixextN/ package folder.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>WixJsonFileExtension</AssemblyName>
    <RootNamespace>Hegsie.Wix.JsonExtension</RootNamespace>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
    <Version>7.0.0</Version>
    <!-- Pinned to the major so a patch release does not change the assembly identity. FileVersion
         is deliberately left to default to $(Version), which the release workflow overrides with
         the tag - otherwise every released binary carries the version hard-coded here rather than
         the one it was published as. -->
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <Authors>hegsie</Authors>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
</Project>
