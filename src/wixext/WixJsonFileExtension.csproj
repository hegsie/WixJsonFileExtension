<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="WixJsonFileExtension.Common.props" />

  <PropertyGroup>
    <Description>WiX Toolset Utility extension</Description>
    <Title>WiX JSON extension</Title>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <WixExtensionPackageFolder>wixext6</WixExtensionPackageFolder>
    <!-- Output of ..\wixext7\WixJsonFileExtension.Wix7.csproj: the same extension compiled against
         WixToolset.Extensibility 7.x, packed into the wixext7/ folder that WiX v7 probes. -->
    <Wix7ExtensionPath>..\wixext7\bin\$(Configuration)\netstandard2.0\WixJsonFileExtension.dll</Wix7ExtensionPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />

    <InternalsVisibleTo Include="WixJsonFileExtension.Tests" />

    <None Include="$(OutDir)WixJsonFileExtension.dll" Pack="true" PackagePath="wixext5/" />

    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildProjectName).targets" PackagePath="build" />
    <Content Include="$(TargetPath)" PackagePath="$(WixExtensionPackageFolder)" />
    <Content Include="$(Wix7ExtensionPath)" PackagePath="wixext7" />
    <Content Include="json.xsd" PackagePath="schemas" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build ordering only: the v7 flavour has the same assembly name, so it must not be
         referenced for compilation, copied to this project's output, or listed as a dependency. -->
    <ProjectReference Include="..\wixext7\WixJsonFileExtension.Wix7.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\wixlib\bin\x64\$(Configuration)\Hegsie.Wix.JsonExtension.Data.json.wixlib">
      <LogicalName>Hegsie.Wix.JsonExtension.Data.json.wixlib</LogicalName>
      <Link>Hegsie.Wix.JsonExtension.Data.json.wixlib</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Extensibility" Version="6.0.1" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">

    <Exec Command="xcopy $(OutDir)\WixJsonFileExtension.dll $(SolutionDir)\TestJsonConfigInstaller  /K /D /H /Y" />
  </Target>

</Project>
